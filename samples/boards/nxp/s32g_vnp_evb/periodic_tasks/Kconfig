mainmenu "S32G periodic application"

source "Kconfig.zephyr"

config SAMPLE_S32G_FLEXCAN_LOOPBACK
	bool "Run FlexCAN0 internal loopback at startup"
	depends on SOC_S32G274A_M7_0
	help
	  Test 1000 classical CAN frames at 500 kbit/s, then disable CAN0.
	  Requires exclusive ownership of CAN0 and an existing stable 40 MHz
	  FXOSC-selected FLEXCAN clock. Does not configure pins or transceivers,
	  change shared clocks, or provide a Zephyr CAN API driver.

config SAMPLE_S32G_CORE_PLL_FXOSC
	bool "Initialize CORE_PLL from the board crystal"
	depends on SOC_S32G274A_M7_0
	help
	  Configure the shared CORE_PLL and DFS1 before SysTick starts, using
	  the existing stable 40 MHz FXOSC to generate a nominal 400 MHz M7
	  clock. Requires exclusive ownership of CORE_PLL and XBAR clocks,
	  stopped A53 and other M7 cores, and no other enabled CORE_PLL output.
	  Disable this option when boot firmware owns the shared clock tree.
