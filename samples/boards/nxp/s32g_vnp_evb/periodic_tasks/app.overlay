#include <zephyr/dt-bindings/pinctrl/nxp-siul2-pinctrl.h>

/ {
	zephyr,user {
		pinctrl-0 = <&eeprom_i2c2_default>;
		pinctrl-names = "default";
	};

	aliases {
		ethernet0 = &gmac0;
	};
};

&siul2_0 {
	eeprom_i2c2_default: eeprom-i2c2-default {
		bus {
			/* PB5/SCL and PB6/SDA use SIUL2_1 IMCR 207/208. */
			pinmux = <NXP_SIUL2_PINMUX(0, 1, 21, 1, 207, 2)>,
				 <NXP_SIUL2_PINMUX(0, 1, 22, 1, 208, 2)>;
			input-enable;
			output-enable;
			drive-open-drain;
			bias-disable;
			nxp,slew-rate = <4>;
		};
	};

	gmac0_default: gmac0-default {
		tx {
			pinmux = <NXP_SIUL2_PINMUX(0, 0, 66, 1, 0, 0)>,
				 <NXP_SIUL2_PINMUX(0, 0, 67, 1, 0, 0)>,
				 <NXP_SIUL2_PINMUX(0, 0, 68, 1, 0, 0)>,
				 <NXP_SIUL2_PINMUX(0, 0, 69, 1, 0, 0)>,
				 <NXP_SIUL2_PINMUX(0, 0, 70, 1, 0, 0)>,
				 <NXP_SIUL2_PINMUX(0, 0, 71, 1, 0, 0)>;
			output-enable;
			nxp,slew-rate = <5>;
		};

		rx {
			pinmux = <NXP_SIUL2_PINMUX(0, 0, 72, 0, 17, 2)>,
				 <NXP_SIUL2_PINMUX(0, 0, 73, 0, 18, 2)>,
				 <NXP_SIUL2_PINMUX(0, 0, 74, 0, 19, 2)>,
				 <NXP_SIUL2_PINMUX(0, 0, 75, 0, 20, 2)>,
				 <NXP_SIUL2_PINMUX(0, 0, 76, 0, 21, 2)>,
				 <NXP_SIUL2_PINMUX(0, 0, 77, 0, 22, 2)>;
			input-enable;
			nxp,slew-rate = <5>;
		};

		mdc {
			pinmux = <NXP_SIUL2_PINMUX(0, 0, 60, 1, 0, 0)>;
			output-enable;
			nxp,slew-rate = <5>;
		};

		mdio {
			pinmux = <NXP_SIUL2_PINMUX(0, 0, 61, 1, 15, 2)>;
			input-enable;
			output-enable;
			nxp,slew-rate = <5>;
		};
	};
};

&gmac0 {
	status = "okay";
	pinctrl-0 = <&gmac0_default>;
	pinctrl-names = "default";
	phy-connection-type = "rgmii";
	phy-handle = <&upper_phy>;
	local-mac-address = [02 00 00 27 4a 00];
	/* Standalone M7 ownership; A53 and other PLL consumers are stopped. */
	nxp,initialize-periph-pll;
};

&gmac0_mdio {
	status = "okay";

	upper_phy: ethernet-phy@4 {
		compatible = "ethernet-phy";
		reg = <4>;
		default-speeds = "1000BASE Full-Duplex";
	};
};
