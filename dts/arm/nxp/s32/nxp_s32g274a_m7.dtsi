#include <arm/armv7-m.dtsi>
#include <nxp/s32/nxp_s32g274a.dtsi>
#include <freq.h>

/ {
	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-m7";
			reg = <0>;
			clock-frequency = <DT_FREQ_M(48)>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-m7";
			reg = <1>;
			clock-frequency = <DT_FREQ_M(48)>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-m7";
			reg = <2>;
			clock-frequency = <DT_FREQ_M(48)>;
		};
	};

	soc {
		interrupt-parent = <&nvic>;
	};
};

&nvic {
	arm,num-irq-priority-bits = <4>;
};
